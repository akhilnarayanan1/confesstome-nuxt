rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    match /users/{userId} {
    	allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isOwner(userId);
    }
    
    match /messages/{messageId} {
      allow read: if isSignedIn() && isEitherSenderOrReceiverRead();
      allow create: if isSignedIn() && isSender() && !isSenderReciverSame() && isValidMessageContent();
      allow update, delete: if false; // Explicitly deny updates and deletes
    }
    
    match /replies/{replyId} {
      allow read: if isSignedIn() && isEitherSenderOrReceiverReply();
      allow create: if isSignedIn() && isValidReplyCreation();
      allow update, delete: if false; // Explicitly deny updates and deletes
    }
    
    // Functions //
    // function OwnerRegistered(){
    // 	return exists(/databases/$(database)/documents/users/$(request.auth.uid))
    // }
    
    function isEitherSenderOrReceiverRead() {
    	return (resource.data.to == request.auth.uid) || (resource.data.from == request.auth.uid);
    }
    
    function isSender() {
    	return (request.resource.data.from == request.auth.uid)
    }
    
    function isSenderReciverSame() {
    	return request.resource.data.to == request.resource.data.from;
    } 
    
    function isOwner(userId) {
    	return request.auth.uid == userId;
    }
    
    function isSignedIn() {
    	return request.auth != null;
    }
    
    // Reply access control functions
    function isEitherSenderOrReceiverReply() {
    	return (resource.data.to == request.auth.uid) || (resource.data.from == request.auth.uid);
    }
    
    function isValidReplyCreation() {
    	return isValidReplySender() && 
           isValidReplyToMessage(request.resource.data.cid) && 
           isValidReplyContent();
    }
    
    function isValidReplySender() {
    	return request.resource.data.from == request.auth.uid;
    }
    
    function isValidReplyToMessage(messageId) {
    	let messageDoc = get(/databases/$(database)/documents/messages/$(messageId));
    	return (messageDoc.data.from == request.auth.uid) || (messageDoc.data.to == request.auth.uid);
    }
    
    // Content validation functions
    function isValidMessageContent() {
    	return request.resource.data.message is string &&
           request.resource.data.message.size() > 0 && 
           request.resource.data.message.size() <= 1000 &&
           hasRequiredMessageFields();
    }
    
    function isValidReplyContent() {
    	return request.resource.data.reply is string &&
           request.resource.data.reply.size() > 0 && 
           request.resource.data.reply.size() <= 1000 &&
           hasRequiredReplyFields();
    }
    
    function hasRequiredMessageFields() {
    	return request.resource.data.keys().hasAll(['message', 'from', 'to', 'createdOn', 'fakename', 'fakecolor']) &&
           request.resource.data.from is string &&
           request.resource.data.to is string &&
           request.resource.data.fakename is string &&
           request.resource.data.fakecolor is string;
    }
    
    function hasRequiredReplyFields() {
    	return request.resource.data.keys().hasAll(['reply', 'cid', 'from', 'to', 'createdOn', 'fakename', 'fakecolor']) &&
           request.resource.data.cid is string &&
           request.resource.data.from is string &&
           request.resource.data.to is string &&
           request.resource.data.fakename is string &&
           request.resource.data.fakecolor is string;
    }
    
  }
}